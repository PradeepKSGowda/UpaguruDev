# ==============================================================================
# UPA-GURU Scraper Microservice Environment Variables Template
# Copy to scraper/.env for local worker execution
# ==============================================================================

ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# Supabase (Service Role Required for Scraper to bypass RLS and insert to draft_notifications)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro

# Upstash Redis (Deduplication locks & rate limiting)
REDIS_URL=rediss://default:your-token@your-endpoint.upstash.io:6379

# Internal API Authentication (Protect trigger endpoints)
SCRAPER_API_SECRET=your-internal-bearer-secret-token

# Alerting Webhook (Discord / Slack / Telegram for crawl failures)
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your-id/your-token
ALERT_WEBHOOK_ENABLED=false

# PDF Storage & Download Settings
PDF_MAX_DOWNLOAD_SIZE_MB=25
PDF_DOWNLOAD_TIMEOUT_SECONDS=45
HEADLESS_BROWSER=true

# Sentry Error Tracking & Performance Monitoring (TASK-07010102)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Healthchecks.io Dead-Man's Switch Crawler Heartbeats (TASK-07030101)
HEALTHCHECKS_BASE_URL=https://hc-ping.com
HEALTHCHECKS_PING_KEY=your-healthchecks-project-ping-key
HEALTHCHECKS_KPSC_UUID=your-kpsc-check-uuid-or-slug
HEALTHCHECKS_UPSC_UUID=your-upsc-check-uuid-or-slug
HEALTHCHECKS_SSC_UUID=your-ssc-check-uuid-or-slug
HEALTHCHECKS_RRB_UUID=your-rrb-check-uuid-or-slug

# Telegram Operator Alert Channel for Crawler Crashes (TASK-07030101)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_ADMIN_CHAT_ID=-1001234567890


