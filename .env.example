# =============================================================================
# UPA-GURU Environment Configuration Template (.env.example)
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or credentials to source control.
# =============================================================================

# 1. Supabase Infrastructure
# Public URL and Anonymous Key (Safe for client-side bundle via NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (STRICTLY SERVER-SIDE ONLY - Never expose in client code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connection Strings (PostgreSQL 15+)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# 2. Authentication Providers (TASK-01020101)
# Google OAuth 2.0 Credentials (Configured in Google Cloud Console & Supabase Auth Dashboard)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Application Host & Auth Callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# 3. Redis & Caching (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# 4. Observability & Monitoring (Sentry Full-Stack Error Tracking) (TASK-07010101)
# Public DSN for Next.js browser client runtime
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# Server DSN for Node.js runtime and route handlers
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# Sentry CLI Auth Token for release tracking and source map uploads
SENTRY_AUTH_TOKEN=your-sentry-cli-auth-token
# Organization & Project slug for source map attribution
SENTRY_ORG=upa-guru
SENTRY_PROJECT=upa-guru-web
# Environment tag (development, staging, production)
SENTRY_ENVIRONMENT=development

# Product Analytics: Google Analytics 4 (GA4) (TASK-07020101)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Product Analytics: PostHog (TASK-07020101)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# 5. Firebase Cloud Messaging (FCM) Web Push (TASK-05020101)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-public-vapid-key
FIREBASE_SERVER_KEY=your-firebase-server-key-or-admin-sdk-json

# 6. Telegram Bot Alert Integration (TASK-05030101)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret-token-32-chars
TELEGRAM_BOT_USERNAME=UpaguruBot

# 7. WhatsApp Business Cloud API (TASK-05040101)
WHATSAPP_ACCESS_TOKEN=EAAG...your-meta-system-user-or-user-access-token
WHATSAPP_PHONE_NUMBER_ID=100609...your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=10892...your-waba-id
WHATSAPP_TEMPLATE_NAME=exam_alert_notification
WHATSAPP_API_VERSION=v20.0

# 8. Email Delivery & Digest Integration (Resend API) (TASK-05040102)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz
RESEND_FROM_EMAIL=UPA-GURU Exam Alerts <alerts@upaguru.in>

# 9. Omnichannel Dispatch Webhooks (TASK-05050101)
DISPATCH_WEBHOOK_SECRET=your-dispatch-webhook-secret-token-32-chars
SUPABASE_WEBHOOK_SECRET=your-supabase-db-webhook-secret-token
